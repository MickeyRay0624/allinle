<view class="page">
  <view class="title">手牌复盘</view>
  <view wx:if="{{replay}}" class="subtitle">房间 {{replay.roomCode}} · 第 {{replay.handNo}} 手</view>
  <view wx:else class="subtitle">{{loading ? '加载中' : '暂无复盘数据'}}</view>

  <view wx:if="{{replay}}" class="section card table-panel">
    <view class="table-head">
      <view>
        <view class="card-title">公共牌</view>
        <view class="card-desc">底池 {{replay.potSize}} · 盲注 {{replay.blinds.smallBlind}} / {{replay.blinds.bigBlind}}</view>
      </view>
      <view class="status-pill">{{replay.status}}</view>
    </view>
    <view class="board">
      <view wx:for="{{replay.boardCards}}" wx:key="*this" class="poker-card">{{item}}</view>
    </view>
  </view>

  <view wx:if="{{replay}}" class="section">
    <view class="card-title">座位结果</view>
    <view wx:for="{{replay.players}}" wx:key="seatNo" class="card player-card">
      <view class="row between">
        <view>
          <view class="card-title">#{{item.seatNo}} {{item.nickname}}</view>
          <view class="card-desc">{{item.finalStatus}} · 净结果 {{item.netResult || 0}}</view>
        </view>
        <view class="metric small">{{item.endChips || 0}}</view>
      </view>
      <view class="board small">
        <block wx:if="{{item.holeCardsHidden}}">
          <view class="poker-card hidden">?</view>
          <view class="poker-card hidden">?</view>
          <view class="hidden-reason">该玩家未摊牌，底牌按复盘规则隐藏</view>
        </block>
        <block wx:else>
          <view wx:for="{{item.holeCards}}" wx:key="*this" class="poker-card private">{{item}}</view>
        </block>
      </view>
      <view wx:if="{{item.handRankDescription}}" class="card-desc">{{item.handRankDescription}}</view>
    </view>
  </view>

  <view wx:if="{{replay}}" class="section">
    <view class="card-title">动作流水</view>
    <view wx:for="{{replay.actions}}" wx:key="index" class="action-row">
      <view class="action-index">{{item.index}}</view>
      <view class="action-main">
        <view class="action-title">{{item.nickname}} · {{item.actionType}}</view>
        <view class="muted">
          <text>{{item.street}}</text>
          <text wx:if="{{item.amount}}"> · {{item.amount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{replay}}" class="section">
    <t-button variant="outline" block bindtap="backToRoom">回到房间</t-button>
  </view>
</view>
