<view class="page"><view class="title">团队记账</view><view class="subtitle">线下牌局逐手记录，多人确认，清晰汇总每一手和最终输赢。</view>
<view wx:if="{{mode === ''}}" class="section"><view class="description"><view class="desc-title">团队记账说明</view><view class="desc-text">先设置每人带入筹码，再逐手输入赢输金额，系统校验平衡并由全员确认，最终生成结算建议。</view><view class="desc-note">仅用于线下牌局账目记录，不涉及发牌、下注和资金处理。</view></view><view class="button-stack"><t-button theme="primary" bindtap="toggleCreateForm">创建记账房</t-button><t-button bindtap="toggleJoinForm">加入已有房间</t-button></view></view>
<view wx:if="{{showCreateForm}}" class="card"><t-input value="{{titleInput}}" placeholder="房间标题" bindchange="onTitleInput"/><t-button theme="primary" bindtap="doCreateRoom">创建</t-button></view><view wx:if="{{showJoinForm}}" class="card"><t-input value="{{roomCodeInput}}" maxlength="6" placeholder="6 位房间码" bindchange="onRoomCodeInput"/><t-button theme="primary" bindtap="doJoinRoom">加入</t-button></view>
<block wx:if="{{room}}"><view class="card"><view class="card-title">{{room.title}} · {{room.roomCode}}</view><view class="card-desc">状态 {{room.status}} · 已完成 {{room.currentHandNo}} 手</view></view><view class="card"><view class="card-title">成员</view><view wx:for="{{room.participants}}" wx:key="id" class="member-row"><text>#{{item.seatNo}} {{item.displayName}}</text><text>{{item.role === 'OWNER' ? '房主' : (item.userId ? '成员' : '临时玩家')}}</text></view></view>
<view wx:if="{{room.status === 'WAITING' && isOwner}}" class="button-stack"><t-button bindtap="toggleTempPlayerForm">添加临时玩家</t-button><t-button theme="primary" bindtap="startRoom">开始记账</t-button></view><view wx:if="{{showTempPlayerForm}}" class="card"><t-input value="{{tempNameInput}}" placeholder="现场玩家昵称" bindchange="onTempNameInput"/><t-button bindtap="addTempPlayer">添加</t-button></view>
<view wx:if="{{isBuyInPhase}}" class="card"><view class="card-title">带入筹码</view><view wx:for="{{room.participants}}" wx:key="id" class="entry-row"><text>{{item.displayName}}</text><text>{{item.buyInAmount === null || item.buyInAmount === undefined ? '未设置' : '+' + item.buyInAmount}}</text></view><t-input value="{{myBuyIn}}" type="digit" placeholder="我的带入金额" bindchange="onBuyInInput"/><t-button theme="primary" bindtap="setBuyIn">确认带入筹码</t-button><t-button wx:if="{{allHaveBuyIn && isOwner}}" bindtap="nextHand">开始第 1 手牌</t-button></view>
<block wx:if="{{currentHand}}"><view class="card"><view class="card-title">第 {{currentHand.handNo}} 手 · {{currentHand.status}}</view><view wx:for="{{currentHand.entries}}" wx:key="id" class="entry-row"><view><text>{{item.participant.displayName}}</text><view wx:if="{{item.status === 'DISPUTED'}}" class="unbalanced-text">异议原因：{{item.disputeNote || '未填写原因'}}</view></view><text wx:if="{{item.status === 'PENDING'}}">未提交</text><text wx:elif="{{item.status === 'DISPUTED'}}" class="unbalanced">有异议，待重新提交</text><text wx:else class="{{item.amount >= 0 ? 'positive' : 'negative'}}">{{item.amount >= 0 ? '+' : ''}}{{item.amount}}</text></view></view>
<view wx:if="{{currentHand.status === 'OPEN' || currentHand.status === 'DISPUTED'}}" class="card"><view class="card-title">我的本手净输赢</view><view class="dual-input-row"><t-input value="{{myWinEntry}}" type="digit" placeholder="赢多少" bindchange="onWinInput"/><t-input value="{{myLossEntry}}" type="digit" placeholder="输多少" bindchange="onLossInput"/></view><t-button theme="primary" bindtap="submitEntry">提交金额</t-button><t-button bindtap="checkBalance">查看余额</t-button><view wx:if="{{showMyBalance}}" class="balance-card"><view class="balance-row"><text>我的当前余额</text><text class="{{myBalance >= 0 ? 'positive' : 'negative'}}">{{myBalance}}</text></view><view class="card-desc">带入 {{myBalanceBuyIn}} + 累计净输赢 {{myBalanceNet >= 0 ? '+' : ''}}{{myBalanceNet}}</view></view><view wx:if="{{balance}}">本手合计 {{balance.total}} · 已提交 {{balance.submittedCount}}/{{balance.totalCount}}</view><t-button wx:if="{{isOwner && balance.isBalanced && balance.allSubmitted}}" bindtap="requestConfirmation">请求全员确认</t-button></view>
<view wx:if="{{currentHand.status === 'CONFIRMING'}}" class="card"><view class="card-title">请核对完整账目</view><view class="card-desc">已确认 {{confirmationCount}} / {{confirmationTotal}} 人</view><view wx:if="{{myConfirmed}}" class="balanced-text">✓ 我已确认本手</view><t-button wx:else theme="primary" bindtap="confirmHand">确认本手</t-button><t-input value="{{disputeNote}}" placeholder="异议原因" bindchange="onDisputeNoteInput"/><t-button wx:if="{{!myConfirmed}}" theme="danger" bindtap="disputeHand">有异议</t-button></view><view wx:if="{{currentHand.status === 'LOCKED'}}" class="card"><view class="balanced-text">第 {{currentHand.handNo}} 手牌已确认并锁定</view><view class="card-desc">已确认 {{confirmationCount}} / {{confirmationTotal}} 人</view><view wx:if="{{myConfirmed}}" class="balanced-text">✓ 我已确认本手</view><t-button wx:if="{{isOwner}}" bindtap="nextHand">开始下一手</t-button></view></block>
<view wx:if="{{room.status === 'ACTIVE'}}" class="button-stack"><t-button bindtap="loadSummary">查看汇总</t-button><t-button bindtap="loadSettlement">生成结算</t-button><t-button wx:if="{{isOwner && currentHand.status === 'LOCKED'}}" bindtap="endRoom">结束记账牌局</t-button></view></block>
<view wx:if="{{summary}}" class="card"><view class="card-title">累计汇总</view><view wx:for="{{summary.participants}}" wx:key="id" class="member-row"><text>{{item.displayName}}（带入 +{{item.buyInAmount}}）</text><text class="{{item.finalAmount >= 0 ? 'positive' : 'negative'}}">最终 {{item.finalAmount >= 0 ? '+' : ''}}{{item.finalAmount}}</text></view></view><view wx:if="{{settlements.length}}" class="card"><view class="card-title">结算建议</view><view wx:for="{{settlements}}" wx:key="id">{{item.fromName}} → {{item.toName}}：{{item.amount}}</view></view></view>
