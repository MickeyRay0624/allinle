.panel {
  padding: 28rpx;
  background: #161616;
  border: 1rpx solid #2a2a2a;
  border-radius: 8rpx;
}

.panel-title {
  margin-bottom: 18rpx;
  color: #f4d06f;
  font-size: 30rpx;
  font-weight: 700;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.option {
  min-height: 88rpx;
  padding: 18rpx;
  background: #101010;
  border: 1rpx solid #333333;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.option.active {
  background: #2d2410;
  border-color: #f4d06f;
}

.option-main {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.option-sub {
  margin-top: 6rpx;
  color: #9c9c9c;
  font-size: 22rpx;
}
