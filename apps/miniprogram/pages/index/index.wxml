<view class="page">
  <view class="title">ALLINLE</view>
  <view class="subtitle">德扑记账与牌技训练工具</view>

  <view class="section">
    <view wx:for="{{cards}}" wx:key="title" class="card" bindtap="navigate" data-url="{{item.url}}">
      <view class="card-title">{{item.title}}</view>
      <view class="card-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
