.table-page {
  min-height: 100vh;
  background: #080808;
  color: #f5f5f5;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

/* ===== 顶部信息栏 ===== */
.table-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #0d0d0d;
  border-bottom: 1rpx solid #1a1a1a;
  flex-shrink: 0;
}
.header-left, .header-center, .header-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.header-room { font-size: 22rpx; color: #f4d06f; font-weight: 600; }
.header-hand { font-size: 20rpx; color: #888; }
.header-street { font-size: 24rpx; font-weight: 700; color: #f4d06f; }
.header-pot { font-size: 20rpx; color: #aaa; }
.header-blinds { font-size: 20rpx; color: #888; }
.header-status { font-size: 16rpx; }
.header-status.online { color: #5cb85c; }
.header-status.offline { color: #e34d59; }

/* ===== 牌桌区 ===== */
.table-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx;
  position: relative;
  background: radial-gradient(ellipse at center, #1a2a1a 0%, #080808 70%);
  border: 2rpx solid #1a3020;
  border-radius: 32rpx;
  margin: 12rpx;
  min-height: 560rpx;
}

/* 公共牌 */
.board-cards {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.board-label {
  font-size: 20rpx;
  color: #888;
}
.board-row {
  display: flex;
  gap: 12rpx;
}

/* 底池 */
.pot-display {
  margin-bottom: 16rpx;
  padding: 8rpx 24rpx;
  background: rgba(244, 208, 111, 0.12);
  border-radius: 16rpx;
  border: 1rpx solid rgba(244, 208, 111, 0.25);
}
.pot-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #f4d06f;
}

/* ===== 玩家座位布局 ===== */
.seat-layout {
  width: 100%;
  display: grid;
  gap: 10rpx;
  padding: 8rpx;
}

/* 2人: 上下各1 */
.seat-count-2 {
  grid-template-areas:
    "top"
    "bot";
  grid-template-rows: 1fr 1fr;
}
.seat-count-2 .position-top { justify-self: center; }
.seat-count-2 .position-bot { justify-self: center; }

/* 3人: 上方2 下方1 */
.seat-count-3 {
  grid-template-areas:
    "t0 t1"
    "bot bot";
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

/* 4人: 上下各2 */
.seat-count-4 {
  grid-template-areas:
    "t0 t1"
    "b0 b1";
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

/* 5人: 上方3 下方2 */
.seat-count-5 {
  grid-template-areas:
    "t0 t1 t2"
    ". b0 b1";
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

/* 6人: 上方3 下方3 */
.seat-count-6 {
  grid-template-areas:
    "t0 t1 t2"
    "b0 b1 b2";
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr;
}

/* 7-9人: 椭圆分布 */
.seat-count-7, .seat-count-8, .seat-count-9 {
  grid-template-areas:
    "t0 t1 t2"
    "l0 . r0"
    "b0 b1 b2";
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
}

/* ===== 单个座位 ===== */
.seat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx;
  background: rgba(0,0,0,0.3);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  min-width: 140rpx;
}
.seat.active-turn {
  border-color: #f4d06f;
  background: rgba(244, 208, 111, 0.08);
  box-shadow: 0 0 20rpx rgba(244, 208, 111, 0.2);
  animation: seatPulse 1.5s ease-in-out infinite;
}
.seat.current {
  border-color: #5cb85c;
}
.seat.folded {
  opacity: 0.45;
}
.seat.all-in {
  border-color: #e34d59;
}
.seat.out {
  opacity: 0.3;
}
.seat-cards {
  display: flex;
  gap: 6rpx;
}
.seat-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.seat-name {
  font-size: 22rpx;
  color: #ddd;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.seat-chips {
  font-size: 22rpx;
  font-weight: 700;
  color: #f4d06f;
}
.seat-badges {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.badge {
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
.badge.dealer { background: #f4d06f; color: #0c0c0c; }
.badge.thinking { background: transparent; color: #f4d06f; animation: dotsPulse 1s infinite; }
.badge.folded-badge { background: rgba(255,255,255,0.1); color: #888; }
.badge.allin-badge { background: #e34d59; color: #fff; }
.badge.out-badge { background: #333; color: #666; }
.badge.winner-badge { background: #f4d06f; color: #0c0c0c; animation: winnerGlow 0.8s ease-in-out infinite alternate; }

/* 动作气泡 */
.action-bubble {
  position: absolute;
  top: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
  animation: bubbleUp 1.5s ease-out forwards;
}
.action-bubble.Call, .action-bubble.Check { background: rgba(255,255,255,0.15); color: #ccc; }
.action-bubble.Bet, .action-bubble.Raise { background: rgba(244,208,111,0.25); color: #f4d06f; }
.action-bubble.Fold { background: rgba(255,255,255,0.08); color: #888; text-decoration: line-through; }
.action-bubble.All-in { background: rgba(227,77,89,0.3); color: #e34d59; }

/* ===== 我自己的区域 ===== */
.my-area {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #0d0d0d;
  border-top: 1rpx solid #1a1a1a;
  flex-shrink: 0;
}
.my-cards { display: flex; flex-direction: column; gap: 4rpx; }
.my-label { font-size: 20rpx; color: #888; }
.my-cards-row { display: flex; gap: 12rpx; }
.my-chips { text-align: right; font-size: 20rpx; color: #888; }
.chips-value { display: block; font-size: 32rpx; font-weight: 700; color: #f4d06f; }
.my-turn-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #f4d06f;
  padding: 8rpx 20rpx;
  background: rgba(244,208,111,0.1);
  border-radius: 8rpx;
  animation: seatPulse 1.5s ease-in-out infinite;
}
.my-turn-label.waiting {
  color: #888;
  background: transparent;
  animation: none;
}

/* ===== 操作区 ===== */
.action-area {
  padding: 16rpx 24rpx;
  background: #0d0d0d;
  flex-shrink: 0;
}
.action-input { margin-bottom: 12rpx; }
.action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}
.act-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  color: #111;
  font-size: 24rpx;
  font-weight: 700;
  background: #e0e0e0;
  border: 0;
  border-radius: 8rpx;
  padding: 0;
}
.act-btn::after { border: none; }
.act-btn.bet { background: #f4d06f; }
.act-btn.allin { background: #e34d59; color: #fff; }
.act-btn[disabled] { background: #333; color: #666; }

/* ===== 手牌结束 ===== */
.hand-finished-area {
  padding: 24rpx;
  background: #0d0d0d;
  flex-shrink: 0;
}
.finished-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f4d06f;
  text-align: center;
  margin-bottom: 16rpx;
}
.winner-section { margin-bottom: 16rpx; }
.pot-result {
  padding: 12rpx;
  margin-bottom: 10rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 8rpx;
}
.pot-label { font-size: 24rpx; color: #f4d06f; margin-bottom: 6rpx; }
.winner-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #ddd;
  padding: 4rpx 0;
}
.hand-desc { color: #f4d06f; font-style: italic; }
.finished-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* ===== 动画 ===== */
@keyframes seatPulse {
  0%, 100% { box-shadow: 0 0 12rpx rgba(244,208,111,0.15); }
  50% { box-shadow: 0 0 28rpx rgba(244,208,111,0.35); }
}
@keyframes dotsPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
@keyframes winnerGlow {
  0% { box-shadow: 0 0 8rpx rgba(244,208,111,0.3); }
  100% { box-shadow: 0 0 24rpx rgba(244,208,111,0.7); }
}
@keyframes bubbleUp {
  0% { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(-40rpx); }
}
.seat-invested {
  font-size: 18rpx;
  color: #e8b730;
  margin-top: 2rpx;
}

/* ===== 2026 mobile table refresh ===== */
.table-page {
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(160deg, #080b0a 0%, #111714 48%, #060807 100%);
}
.table-header {
  min-height: 72rpx;
  padding: 14rpx 28rpx;
  background: rgba(8, 12, 10, 0.96);
  border-bottom: 1rpx solid rgba(216, 177, 78, 0.28);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.28);
  z-index: 20;
}
.header-room, .header-street { color: #f2ce72; }
.header-status.online { text-shadow: 0 0 12rpx rgba(67, 210, 135, 0.8); }

.table-area {
  min-height: 0;
  flex: 1 1 auto;
  margin: 18rpx 22rpx 12rpx;
  padding: 0;
  overflow: hidden;
  justify-content: center;
  border: 0;
  border-radius: 48% / 24%;
  background: transparent;
  box-shadow: 0 24rpx 50rpx rgba(0, 0, 0, 0.5);
}
.table-rail, .table-felt, .felt-line {
  position: absolute;
  pointer-events: none;
}
.table-rail {
  inset: 0;
  border-radius: 48% / 24%;
  background: linear-gradient(145deg, #49331f 0%, #17130f 22%, #735034 46%, #16120e 72%, #4f3522 100%);
  border: 3rpx solid #8a633a;
  box-shadow: inset 0 0 0 10rpx #161711, inset 0 0 0 14rpx rgba(225, 183, 92, 0.4), 0 0 24rpx rgba(0, 0, 0, 0.85);
}
.table-felt {
  inset: 24rpx 22rpx;
  border-radius: 48% / 24%;
  background:
    radial-gradient(circle at 50% 40%, rgba(81, 180, 128, 0.22), transparent 42%),
    repeating-linear-gradient(18deg, rgba(255,255,255,0.012) 0, rgba(255,255,255,0.012) 2rpx, transparent 2rpx, transparent 7rpx),
    linear-gradient(150deg, #0f704d 0%, #07543b 52%, #063b2b 100%);
  border: 2rpx solid rgba(122, 228, 175, 0.3);
  box-shadow: inset 0 0 60rpx rgba(0,0,0,0.5);
}
.felt-line {
  border: 2rpx solid rgba(235, 222, 174, 0.18);
  border-radius: 50%;
}
.felt-line-one { inset: 70rpx 76rpx; }
.felt-line-two { inset: 116rpx 130rpx; border-style: dashed; }
.table-brand {
  position: absolute;
  left: 50%;
  top: 64%;
  transform: translate(-50%, -50%);
  color: rgba(240, 220, 159, 0.16);
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  z-index: 2;
}
.board-cards, .pot-display { position: relative; z-index: 8; }
.board-cards { margin-top: -10rpx; margin-bottom: 14rpx; }
.board-label { color: rgba(255,255,255,0.5); letter-spacing: 3rpx; }
.pot-display {
  background: rgba(4, 35, 25, 0.82);
  border-color: rgba(244, 208, 111, 0.45);
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.35);
}
.seat-layout {
  position: absolute;
  inset: 30rpx 34rpx;
  width: auto;
  padding: 0;
  z-index: 10;
  pointer-events: none;
}
.seat {
  pointer-events: auto;
  align-self: center;
  max-width: 184rpx;
  min-width: 132rpx;
  padding: 9rpx 12rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(22, 27, 24, 0.95), rgba(5, 9, 7, 0.96));
  border: 1rpx solid rgba(255,255,255,0.16);
  box-shadow: 0 8rpx 18rpx rgba(0,0,0,0.45);
}
.seat.active-turn { border-width: 3rpx; }
.seat.current { box-shadow: 0 0 0 2rpx rgba(63, 206, 129, 0.45), 0 10rpx 22rpx rgba(0,0,0,0.48); }
.seat-name { color: #fff; font-weight: 650; }
.seat-chips::before { content: "◆ "; font-size: 16rpx; color: #dcaa42; }

.my-area {
  min-height: 112rpx;
  padding: 12rpx 28rpx;
  background: linear-gradient(180deg, rgba(14, 20, 17, 0.98), #080b09);
  border-top-color: rgba(216, 177, 78, 0.24);
  box-shadow: 0 -12rpx 30rpx rgba(0,0,0,0.34);
  z-index: 20;
}
.my-turn-label { border: 1rpx solid rgba(244,208,111,0.28); }

.action-area {
  padding: 14rpx 22rpx calc(env(safe-area-inset-bottom) + 30rpx);
  background: linear-gradient(180deg, #111713, #070a08);
  border-top: 1rpx solid rgba(216, 177, 78, 0.28);
  box-shadow: 0 -14rpx 36rpx rgba(0,0,0,0.42);
  z-index: 30;
}
.action-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  color: #f5d47f;
  font-size: 24rpx;
  font-weight: 700;
}
.action-hint { color: #78847d; font-size: 20rpx; font-weight: 400; }
.action-input {
  margin: 0 0 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(244,208,111,0.3);
  border-radius: 14rpx;
}
.action-grid { gap: 12rpx; }
.act-btn {
  height: 96rpx;
  flex-direction: column;
  gap: 0;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.1;
  color: #fff;
  background: linear-gradient(180deg, #39423d, #202622);
  border: 1rpx solid rgba(255,255,255,0.14);
  box-shadow: 0 7rpx 0 #0c0f0d, 0 10rpx 18rpx rgba(0,0,0,0.32);
}
.act-btn:active { transform: translateY(5rpx); box-shadow: 0 2rpx 0 #0c0f0d; }
.act-icon { position: absolute; left: 12rpx; top: 8rpx; font-size: 20rpx; opacity: 0.65; }
.act-en { margin-top: 4rpx; font-size: 15rpx; letter-spacing: 2rpx; opacity: 0.55; }
.act-btn.fold { background: linear-gradient(180deg, #654444, #382426); }
.act-btn.check, .act-btn.call { background: linear-gradient(180deg, #3d5148, #22332b); }
.act-btn.bet, .act-btn.raise { color: #211708; background: linear-gradient(180deg, #f1cd72, #b98731); border-color: #ffe7a6; }
.act-btn.allin { background: linear-gradient(180deg, #e75a62, #9e2635); }
.act-btn[disabled] { color: #626964; background: #202521; border-color: #282e2a; box-shadow: none; opacity: 0.58; }

.hand-finished-area {
  padding: 22rpx 24rpx calc(env(safe-area-inset-bottom) + 26rpx);
  background: linear-gradient(180deg, #111713, #070a08);
}

/* Keep every seat outside the protected community-card zone. */
.seat-layout,
.seat-count-2, .seat-count-3, .seat-count-4, .seat-count-5,
.seat-count-6, .seat-count-7, .seat-count-8, .seat-count-9 {
  display: block;
}
.seat-layout .seat {
  position: absolute;
  margin: 0;
  box-sizing: border-box;
}
.seat-layout .position-top {
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}
.seat-layout .position-bot {
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
}
.seat-layout .position-t0 { left: 0; top: 0; }
.seat-layout .position-t1 { left: 50%; top: 0; transform: translateX(-50%); }
.seat-layout .position-t2 { right: 0; top: 0; }
.seat-layout .position-b0 { left: 0; bottom: 0; }
.seat-layout .position-b1 { left: 50%; bottom: 0; transform: translateX(-50%); }
.seat-layout .position-b2 { right: 0; bottom: 0; }
.seat-layout .position-l0 { left: 0; top: 50%; transform: translateY(-50%); }
.seat-layout .position-r0 { right: 0; top: 42%; transform: translateY(-50%); }
.seat-layout .position-r1 { right: 0; top: 66%; transform: translateY(-50%); }

/* Count-specific spacing keeps sparse tables balanced. */
.seat-count-3 .position-t0,
.seat-count-4 .position-t0 { left: 9%; }
.seat-count-3 .position-t1,
.seat-count-4 .position-t1 { left: auto; right: 9%; transform: none; }
.seat-count-4 .position-b0 { left: 9%; }
.seat-count-4 .position-b1 { left: auto; right: 9%; transform: none; }
.seat-count-5 .position-b0 { left: 16%; }
.seat-count-5 .position-b1 { left: auto; right: 16%; transform: none; }

/* The board sits in a dedicated clear layer above the felt, never under seats. */
.board-cards {
  z-index: 15;
  min-width: 350rpx;
  min-height: 118rpx;
  justify-content: center;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(2, 43, 29, 0.52);
  box-shadow: inset 0 0 24rpx rgba(0,0,0,0.24), 0 8rpx 22rpx rgba(0,0,0,0.18);
}
.board-row { justify-content: center; }

/* Native buttons have auto horizontal margins; reset them for equal tiles. */
.action-grid .act-btn {
  width: 100%;
  min-width: 0;
  max-width: none;
  height: 96rpx;
  min-height: 96rpx;
  margin: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
}
.action-grid .act-btn[disabled] {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  border-radius: 16rpx;
}
