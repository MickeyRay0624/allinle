<view class="page">
  <view class="title">好友练习房</view>
  <view class="subtitle">房间码 {{roomCode}} · {{connected ? '实时同步中' : '等待同步'}}</view>

  <!-- 房间信息 -->
  <view wx:if="{{room}}" class="section card">
    <view class="card-title">{{room.status === 'WAITING' ? '等待中' : room.status === 'READY' ? '已就绪' : '练习中'}}</view>
    <view class="card-desc">盲注 {{room.smallBlind}} / {{room.bigBlind}} · 每人自行填写带入筹码 · 最大 {{room.maxPlayers}} 人</view>
  </view>

  <!-- 成员列表 -->
  <view wx:if="{{room}}" class="section">
    <view class="card-title">成员 ({{room.players ? room.players.length : 0}}/{{room.maxPlayers}})</view>
    <view wx:for="{{room.players}}" wx:key="id" class="card member-card">
      <view class="member-row">
        <view class="member-left">
          <view class="member-seat">座位 #{{item.seatNo}}</view>
          <view class="member-name">
            {{item.nickname || '成员'}}
            <text wx:if="{{item.userId === room.ownerUserId}}" class="owner-badge">房主</text>
          </view>
        </view>
        <view class="member-right">
          <view class="member-chips">{{item.chipsSetByPlayer ? '带入筹码 ' + item.chips : '尚未填写筹码'}}</view>
          <view class="member-status">
            <text class="status-item {{item.initialChipsConfirmed ? 'done' : 'pending'}}">
              {{item.initialChipsConfirmed ? '✓ 已确认' : '○ 待确认'}}
            </text>
            <text class="status-item {{item.readyStatus ? 'done' : 'pending'}}">
              {{item.readyStatus ? '✓ 已准备' : '○ 未准备'}}
            </text>
          </view>
        </view>
      </view>
    </view>
    <view class="notice" wx:if="{{lastMessage}}">{{lastMessage}}</view>
  </view>

  <view wx:if="{{room && room.status !== 'PLAYING'}}" class="section card">
    <view class="card-title">我的带入筹码</view>
    <t-input value="{{myChips}}" type="number" placeholder="请输入正整数" bindchange="onChipsInput" />
    <t-button theme="primary" block bindtap="saveChips">提交/修改筹码</t-button>
    <view class="card-desc">任何人修改筹码后，所有成员都需要重新核对确认。</view>
  </view>

  <!-- 非房主等待阶段 -->
  <view wx:if="{{room && room.status !== 'PLAYING' && !isOwner}}" class="section">
    <view class="button-stack">
      <t-button theme="warning" block bindtap="confirmChips" disabled="{{myConfirmChips}}">核对无误并确认准备</t-button>
    </view>
    <view wx:if="{{myConfirmChips && myReady}}" class="hint-box">
      <text class="hint-text">✅ 已就绪，等待房主开始练习</text>
    </view>
  </view>

  <!-- 房主操作 -->
  <view wx:if="{{room && room.status !== 'PLAYING' && isOwner}}" class="section">
    <view class="button-stack">
      <t-button theme="warning" block bindtap="confirmChips" disabled="{{myConfirmChips}}">核对无误并确认准备</t-button>
      <t-button theme="warning" block bindtap="startRoom" disabled="{{starting || !canStart}}">
        {{starting ? '正在开始...' : '开始练习'}}
      </t-button>
    </view>
    <view class="hint-box" wx:if="{{canStart && !starting}}">
      <text class="hint-text">✅ 所有成员已就绪，点击「开始练习」进入牌桌</text>
    </view>
    <view class="hint-box muted-box" wx:elif="{{!canStart}}">
      <text class="hint-text muted-text">⏳ 等待所有成员确认筹码并准备</text>
    </view>
  </view>

  <!-- 已在牌局中（重连场景） -->
  <view wx:if="{{room && room.status === 'PLAYING'}}" class="section card">
    <view class="card-title">练习已在进行中</view>
    <view class="card-desc">正在跳转到牌桌...</view>
  </view>

  <!-- 退出 -->
  <view class="section">
    <t-button variant="outline" block bindtap="leaveRoom">退出房间</t-button>
  </view>
</view>
