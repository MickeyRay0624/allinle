<view class="club-page">
  <view class="ambient ambient-one"></view>
  <view class="ambient ambient-two"></view>

  <view class="club-header">
    <view class="eyebrow">ALLINLE PRIVATE CLUB</view>
    <view class="page-title">好友练习房</view>
    <view class="connection-pill {{connected ? 'is-online' : ''}}">
      <view class="connection-dot"></view>
      <text>{{connected ? '实时同步中' : '正在连接'}}</text>
    </view>
  </view>

  <view class="room-pass">
    <view class="pass-shine"></view>
    <view class="pass-topline">
      <text class="pass-label">PRIVATE TABLE</text>
      <text class="pass-status">{{room && room.status === 'READY' ? 'READY' : room && room.status === 'PLAYING' ? 'PLAYING' : 'WAITING'}}</text>
    </view>
    <view class="room-code" bindtap="copyRoomCode">{{roomCode}}</view>
    <view class="copy-hint" bindtap="copyRoomCode">轻触复制房间码</view>
    <view wx:if="{{room}}" class="pass-meta">
      <view class="meta-item"><text class="meta-label">盲注</text><text class="meta-value">{{room.smallBlind}} / {{room.bigBlind}}</text></view>
      <view class="meta-divider"></view>
      <view class="meta-item"><text class="meta-label">席位</text><text class="meta-value">{{displayPlayers.length}} / {{maxPlayers}}</text></view>
      <view class="meta-divider"></view>
      <view class="meta-item"><text class="meta-label">模式</text><text class="meta-value">好友局</text></view>
    </view>
  </view>

  <view wx:if="{{room}}" class="progress-card">
    <view class="section-heading">
      <view><view class="section-kicker">TABLE STATUS</view><view class="section-title">入席进度</view></view>
      <view class="progress-number">{{readyCount}}<text>/{{displayPlayers.length}}</text></view>
    </view>
    <view class="progress-track"><view class="progress-fill" style="width: {{readyPercent}}%"></view></view>
    <view class="progress-legend">
      <text>已确认筹码 {{confirmedCount}} 人</text>
      <text>已准备 {{readyCount}} 人</text>
    </view>
  </view>

  <view wx:if="{{room}}" class="players-section">
    <view class="section-heading">
      <view><view class="section-kicker">MEMBERS</view><view class="section-title">本桌成员</view></view>
      <view class="member-total">{{displayPlayers.length}} 位</view>
    </view>
    <view class="player-grid">
      <view wx:for="{{displayPlayers}}" wx:key="id" class="player-tile {{item.readyStatus ? 'is-ready' : ''}} {{item.isMe ? 'is-me' : ''}}">
        <view class="avatar-ring">
          <view class="avatar-core">{{item.initial}}</view>
          <view wx:if="{{item.readyStatus}}" class="ready-orbit"></view>
        </view>
        <view class="player-main">
          <view class="player-name-row">
            <text class="player-name">{{item.nickname}}</text>
            <text wx:if="{{item.isOwner}}" class="owner-chip">房主</text>
            <text wx:if="{{item.isMe}}" class="me-chip">我</text>
          </view>
          <view class="seat-caption">SEAT {{item.seatNo}}</view>
          <view class="chip-line">◆ {{item.chipsSetByPlayer ? item.chips : '待填写'}}</view>
        </view>
        <view class="state-column">
          <view class="state-dot {{item.initialChipsConfirmed ? 'done' : ''}}"></view>
          <text class="state-text">{{item.initialChipsConfirmed ? '已核对' : '待核对'}}</text>
          <text class="ready-text {{item.readyStatus ? 'done' : ''}}">{{item.readyStatus ? 'READY' : 'WAIT'}}</text>
        </view>
      </view>
    </view>
    <view class="notice" wx:if="{{lastMessage}}">{{lastMessage}}</view>
  </view>

  <view wx:if="{{room && room.status !== 'PLAYING'}}" class="buyin-card">
    <view class="section-kicker">YOUR BUY-IN</view>
    <view class="section-title">我的带入筹码</view>
    <view class="buyin-input-wrap">
      <text class="chip-symbol">◆</text>
      <input class="buyin-input" value="{{myChips}}" type="number" placeholder="输入正整数" placeholder-class="input-placeholder" bindinput="onChipsInput" />
      <button class="save-chip-button" bindtap="saveChips">提交</button>
    </view>
    <view class="buyin-note">修改筹码后，全桌成员需要重新核对确认</view>
  </view>

  <view wx:if="{{room && room.status !== 'PLAYING'}}" class="action-dock">
    <button class="club-button secondary {{myConfirmChips ? 'is-disabled' : ''}}" bindtap="confirmChips" disabled="{{myConfirmChips}}">
      <text class="button-icon">✓</text><text>{{myConfirmChips ? '筹码已确认' : '核对筹码并准备'}}</text>
    </button>
    <button wx:if="{{isOwner}}" class="club-button primary {{starting || !canStart ? 'is-disabled' : ''}}" bindtap="startRoom" disabled="{{starting || !canStart}}">
      <text class="button-icon">♠</text><text>{{starting ? '正在开桌...' : '开始练习'}}</text>
    </button>
    <view class="dock-message {{canStart ? 'success' : ''}}">
      {{isOwner ? (canStart ? '全员就绪，可以开始本桌练习' : '等待所有成员确认筹码并准备') : (myConfirmChips && myReady ? '你已就绪，等待房主开桌' : '请确认筹码并完成准备')}}
    </view>
  </view>

  <view wx:if="{{room && room.status === 'PLAYING'}}" class="reconnecting-card">
    <view class="spinner"></view><view><view class="section-title">牌局已开始</view><view class="buyin-note">正在进入私人牌桌</view></view>
  </view>

  <button class="leave-button" bindtap="leaveRoom">退出房间</button>
  <view class="safe-space"></view>
</view>
